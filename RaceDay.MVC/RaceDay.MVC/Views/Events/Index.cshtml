@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <h2>Upcoming Events</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info mt-3">No events found. Check back later!</div>
    }
    else
    {
        <div class="row mt-3">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@ev.name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@ev.eventDate.ToString("dd MMM yyyy")</h6>
                            <p class="card-text">
                                <strong>Location:</strong> @ev.location <br />
                                <strong>Status:</strong> <span class="badge bg-success">@ev.status</span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>